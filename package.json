{
  "name": "vyuh",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "workspaces": [
    "apps/*",
    "docs",
    "schemas/*",
    "examples/*/*"
  ],
  "scripts": {
    "publish-packages": "changeset version && bun run --filter './schemas/*' build && changeset publish",
    "build": "bun run --filter '*' build",
    "docs": "bun run --filter vyuh-docs dev",
    "docs:build": "bun run --filter vyuh-docs build"
  },
  "keywords": [],
  "author": {
    "email": "pavan@vyuh.tech",
    "name": "Pavan Podila",
    "url": "https://github.com/pavanpodila"
  },
  "license": "FSL",
  "devDependencies": {
    "all-contributors-cli": "^6.26.1",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "wrangler": "4.145.0"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3"
  },
  "overrides": {
    "sanity": "^6.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@sanity/types": "^6.17.0"
  },
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "workerd"
  ]
}
